{
  "$schema": "https://opencode.ai/config.json",
  "username": "wa22im",
  "default_agent": "Mrbrain",
  "model": "minimax-coding-plan/MiniMax-M3",
  "small_model": "minimax-coding-plan/MiniMax-M2.7",
  "share": "manual",
  "autoupdate": "notify",
  "snapshot": true,
  "logLevel": "INFO",
  "instructions": ["AGENTS.md"],

  "skills": {
    "paths": ["~/.config/opencode/skills"]
  },

  "permission": {
    "edit": "ask",
    "bash": {
      "git status": "allow",
      "git diff": "allow",
      "git log": "allow",
      "git branch *": "allow",
      "git switch -c *": "allow",
      "git rev-parse *": "allow",
      "gh *": "ask",
      "rm *": "deny",
      "*": "ask"
    },
    "external_directory": {
      "~/.opencode/**": "allow",
      "~/.cache/codebase-memory-mcp/**": "allow",
      "**": "ask"
    }
  },

  "compaction": {
    "auto": true,
    "tail_turns": 15
  },

  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },

  "mcp": {
    "codebase-memory": {
      "type": "local",
      "command": [
        "~/.local/bin/codebase-memory-mcp",
        "--ui=true",
        "--port=9749"
      ],
      "enabled": true
    }
  }
}
